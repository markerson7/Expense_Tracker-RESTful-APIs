{
  "name": "expense-tracker",
  "version": "1.0.0",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "check-coverage": "jest --coverage --coverageThreshold='{\"global\": {\"branches\": 85, \"functions\": 85, \"lines\": 85, \"statements\": 85}}'"
  },
  "dependencies": {
    "bcrypt": "^5.1.0",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.0.0"
  },
  "devDependencies": {
    "jest": "^29.0.0",
    "mongodb-memory-server": "^10.2.0",
    "nodemon": "^2.0.0",
    "supertest": "^6.3.0"
  }
}
